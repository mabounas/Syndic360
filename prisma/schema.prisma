// Syndic360 — schéma de données MVP (sous-ensemble de la section 5 du cahier des charges)
// Multi-tenant par colonne organisationId (pas de schéma-par-tenant, pour rester compatible
// avec le pooling serverless de Neon/Vercel).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SYNDIC_ADMIN
  GESTIONNAIRE
  CONSEIL_BENEVOLE
  COPROPRIETAIRE
  PRESTATAIRE
}

enum LotType {
  APPARTEMENT
  COMMERCE
  PARKING
  CAVE
}

enum TypeOccupant {
  PROPRIETAIRE
  LOCATAIRE
}

enum AppelChargesStatut {
  BROUILLON
  PUBLIE
}

enum QuotePartStatut {
  EN_ATTENTE
  PAYE
  EN_RETARD
}

enum DocumentDossier {
  REGLEMENT
  PV_AG
  CONTRATS
  BUDGETS
  DIVERS
}

enum DocumentVisibilite {
  COMMUN
  PRIVE
}

enum AgType {
  ORDINAIRE
  EXTRAORDINAIRE
}

enum AgStatut {
  PLANIFIEE
  CONVOQUEE
  CLOTUREE
}

enum TypeMajorite {
  ART24
  ART25
  ART26
}

enum VoteValeur {
  POUR
  CONTRE
  ABSTENTION
}

enum EcritureType {
  RECETTE
  DEPENSE
}

// EN_ATTENTE : SYNDIC_ADMIN en attente d'approbation SuperAdmin, ou
// copropriétaire ayant activé son compte en attente d'approbation par
// l'admin de sa résidence. APPROUVE : accès complet. REJETE/BLOQUE :
// aucun accès (distinction : jamais approuvé vs. approuvé puis suspendu).
enum UserStatut {
  EN_ATTENTE
  APPROUVE
  REJETE
  BLOQUE
}

model Organisation {
  id               String   @id @default(cuid())
  nom              String
  plan             String   @default("BENEVOLE")
  iban             String?
  bic              String?
  contactPrenom    String?
  contactNom       String?
  contactEmail     String?
  contactTelephone String?
  createdAt        DateTime @default(now())

  users      User[]
  residences Residence[]

  @@map("organisations")
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  nom            String
  prenom         String
  telephone      String?
  role           Role
  statut         UserStatut @default(APPROUVE)
  passwordSet    Boolean    @default(true)
  organisationId String
  createdAt      DateTime   @default(now())

  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lots              LotProprietaire[]
  documentsUploaded Document[]        @relation("DocumentUploader")
  auditLogs         AuditLog[]
  residenceAdmins   ResidenceAdmin[]
  votes             Vote[]
  relancesEnvoyees  Relance[]

  @@index([organisationId])
  @@map("users")
}

model Residence {
  id             String   @id @default(cuid())
  nom            String
  adresse        String
  ville          String
  nbLots         Int      @default(0)
  totalTantiemes Int      @default(1000)
  organisationId String
  createdAt      DateTime @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  batiments    Batiment[]
  budgets      Budget[]
  documents    Document[]
  admins       ResidenceAdmin[]
  assemblees   Ag[]
  ecritures    EcritureComptable[]
  tickets      Ticket[]

  @@index([organisationId])
  @@map("residences")
}

enum TicketUrgence {
  BASSE
  MOYENNE
  HAUTE
}

enum TicketStatut {
  OUVERT
  EN_COURS
  RESOLU
}

// Tickets techniques (incidents/travaux) signalés au niveau d'une résidence —
// gérés par le syndic/gestionnaire, pas par les copropriétaires directement.
model Ticket {
  id           String        @id @default(cuid())
  titre        String
  description  String
  localisation String
  urgence      TicketUrgence @default(MOYENNE)
  statut       TicketStatut  @default(OUVERT)
  signalePar   String?
  residenceId  String
  createdAt    DateTime      @default(now())

  residence Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)

  @@index([residenceId])
  @@map("tickets")
}

enum ContactStatut {
  NOUVEAU
  TRAITE
}

// Messages du formulaire de contact public — adressés au SUPER_ADMIN de la
// plateforme (pas rattachés à une organisation, l'expéditeur peut être
// n'importe qui : prospect, syndic, copropriétaire).
model ContactMessage {
  id        String        @id @default(cuid())
  nom       String
  email     String
  sujet     String
  message   String
  statut    ContactStatut @default(NOUVEAU)
  createdAt DateTime      @default(now())

  @@map("contact_messages")
}

// Assignation d'un gestionnaire/conseil bénévole à une résidence précise.
// Un SYNDIC_ADMIN voit toutes les résidences de son organisation ; un GESTIONNAIRE
// ou CONSEIL_BENEVOLE ne voit que les résidences où il est explicitement admin.
model ResidenceAdmin {
  id          String   @id @default(cuid())
  residenceId String
  userId      String
  createdAt   DateTime @default(now())

  residence Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([residenceId, userId])
  @@index([userId])
  @@map("residence_admins")
}

model Batiment {
  id          String @id @default(cuid())
  nom         String
  nbEtages    Int    @default(0)
  residenceId String

  residence Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  lots      Lot[]

  @@index([residenceId])
  @@map("batiments")
}

model Lot {
  id                 String  @id @default(cuid())
  numero             String
  type               LotType @default(APPARTEMENT)
  surface            Float?
  tantiemesGeneraux  Int     @default(0)
  tantiemesCharges   Int     @default(0)
  etage              Int?
  montantForfaitaire Float?
  soldeDepart        Float   @default(0)
  batimentId         String

  batiment      Batiment          @relation(fields: [batimentId], references: [id], onDelete: Cascade)
  proprietaires LotProprietaire[]
  quoteParts    QuotePart[]
  documents     Document[]
  votes         Vote[]
  echeances     Echeance[]

  @@index([batimentId])
  @@map("lots")
}

enum EcheanceStatut {
  EN_COURS
  NON_PAYE
  PAYE
}

// Échéancier mensuel par lot, généré automatiquement à l'assignation d'un
// occupant à partir du montant forfaitaire. EN_COURS = mois pas encore
// échu ; bascule automatiquement en NON_PAYE dès que le mois commence
// (voir lib/echeancier.ts), sauf si déjà marqué PAYE par le syndic.
model Echeance {
  id                String         @id @default(cuid())
  lotId             String
  mois              DateTime
  montant           Float
  statut            EcheanceStatut @default(EN_COURS)
  montantRecu       Float?
  datePaiement      DateTime?
  referencePaiement String?
  createdAt         DateTime       @default(now())

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, mois])
  @@index([lotId])
  @@map("echeances")
}

// Table de jointure Lot <-> User : gère l'indivision (plusieurs copropriétaires par lot)
model LotProprietaire {
  id           String       @id @default(cuid())
  lotId        String
  userId       String
  typeOccupant TypeOccupant @default(PROPRIETAIRE)

  lot  Lot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lotId, userId])
  @@index([userId])
  @@map("lot_proprietaires")
}

model Budget {
  id              String @id @default(cuid())
  annee           Int
  montantTotal    Float
  fondsTravauxMin Float  @default(0)
  residenceId     String

  residence     Residence      @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  appelsCharges AppelCharges[]

  @@unique([residenceId, annee])
  @@index([residenceId])
  @@map("budgets")
}

model AppelCharges {
  id           String             @id @default(cuid())
  periode      String
  dateEcheance DateTime
  montantTotal Float
  statut       AppelChargesStatut @default(BROUILLON)
  budgetId     String
  createdAt    DateTime           @default(now())

  budget     Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  quoteParts QuotePart[]

  @@index([budgetId])
  @@map("appels_charges")
}

model QuotePart {
  id                    String          @id @default(cuid())
  appelChargesId        String
  lotId                 String
  montant               Float
  statut                QuotePartStatut @default(EN_ATTENTE)
  datePaiement          DateTime?
  // Champs prévus pour la Phase 2 (paiement en ligne CMI/Stripe) — nullable, pas de logique branchée en V1
  stripePaymentIntentId String?
  cmiRef                String?

  appelCharges AppelCharges @relation(fields: [appelChargesId], references: [id], onDelete: Cascade)
  lot          Lot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  relances     Relance[]

  @@unique([appelChargesId, lotId])
  @@index([lotId])
  @@map("quote_parts")
}

// Historique des relances (déclenchement manuel en V1 — l'envoi email/SMS réel
// nécessite une clé Resend/Twilio non encore configurée, voir section 7.2 du CDC).
model Relance {
  id           String   @id @default(cuid())
  quotePartId  String
  type         String
  envoyeeAt    DateTime @default(now())
  envoyeeParId String?

  quotePart  QuotePart @relation(fields: [quotePartId], references: [id], onDelete: Cascade)
  envoyeePar User?     @relation(fields: [envoyeeParId], references: [id])

  @@index([quotePartId])
  @@map("relances")
}

model Document {
  id          String             @id @default(cuid())
  nom         String
  type        String
  url         String
  taille      Int
  dossier     DocumentDossier    @default(DIVERS)
  visibilite  DocumentVisibilite @default(COMMUN)
  residenceId String
  lotId       String?
  uploaderId  String
  createdAt   DateTime           @default(now())

  residence Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  lot       Lot?      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  uploader  User      @relation("DocumentUploader", fields: [uploaderId], references: [id])

  @@index([residenceId])
  @@index([lotId])
  @@map("documents")
}

// Assemblée générale — section 6.5 du CDC. Calcul de majorité simplifié :
// ART24 = majorité des tantièmes votants ; ART25 = majorité absolue des tantièmes
// de la résidence ; ART26 = double majorité approximée aux 2/3 des tantièmes.
model Ag {
  id                 String   @id @default(cuid())
  date               DateTime
  lieu               String
  type               AgType   @default(ORDINAIRE)
  statut             AgStatut @default(PLANIFIEE)
  convocationEnvoyee Boolean  @default(false)
  residenceId        String
  createdAt          DateTime @default(now())

  residence   Residence    @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  resolutions Resolution[]

  @@index([residenceId])
  @@map("assemblees")
}

model Resolution {
  id           String       @id @default(cuid())
  titre        String
  description  String
  typeMajorite TypeMajorite @default(ART24)
  ordre        Int          @default(0)
  agId         String

  ag    Ag     @relation(fields: [agId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([agId])
  @@map("resolutions")
}

// Un vote par lot et par résolution (le lot porte le poids en tantièmes, quel que
// soit le nombre de co-indivisaires). Enregistré par le copropriétaire lui-même
// (pour son lot) ou par un gestionnaire/conseil bénévole (vote en séance).
model Vote {
  id           String     @id @default(cuid())
  resolutionId String
  lotId        String
  userId       String
  valeur       VoteValeur
  createdAt    DateTime   @default(now())

  resolution Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  lot        Lot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([resolutionId, lotId])
  @@index([lotId])
  @@map("votes")
}

// Comptabilité simplifiée — section 6.4 du CDC (hors plan comptable BNPJ complet
// et rapprochement bancaire OFX, différés). Catégorie en texte libre plutôt qu'un
// plan comptable structuré, pour rester dans le périmètre MVP+Phase2.
model EcritureComptable {
  id             String       @id @default(cuid())
  date           DateTime
  libelle        String
  type           EcritureType
  montant        Float
  categorie      String
  pieceJointeUrl String?
  residenceId    String
  createdAt      DateTime     @default(now())

  residence Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)

  @@index([residenceId])
  @@map("ecritures_comptables")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  cible     String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("audit_logs")
}
